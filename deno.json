{
  "nodeModulesDir": "none",
  "tasks": {
    "start": "deno run --allow-read --allow-write --allow-run --allow-env src/main.ts",
    "doctor": "deno run --allow-read --allow-write --allow-run --allow-env src/main.ts --doctor",
    "check": "deno fmt --check && deno lint && deno check src/main.ts src/send.ts",
    "test": "deno test --allow-read --allow-write tests",
    "validate": "deno task check && deno task test"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "exclude": ["no-process-global", "prefer-const", "require-await"]
    }
  }
}
